{
  "name": "hantsy-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Hantsy's personal blog - built with Angular",
  "scripts": {
    "dev": "ng serve",
    "build": "npm run enrich:tutorials && npm run content:index && ng build",
    "enrich:tutorials": "npx tsx scripts/enrich-tutorials.ts",
    "preview": "npx serve dist/browser",
    "content:index": "npx tsx scripts/generate-content-index.ts"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "fast-xml-parser": "^5.10.1",
    "marked": "^15.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.2.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
